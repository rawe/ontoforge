# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example
# Local overrides of the committed env/ presets — for credentials, which
# must never enter a committed preset.
env/*.local.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output
dist/
build/
*.tgz

# Testing
coverage/

# Logs
*.log
npm-debug.log*

# Neo4j local data
neo4j/data/
neo4j/logs/

# Benchmark results (local comparison data)
.bench-results.json
.bench-baseline.json

# Temporary working files (not committed)
.tmp/
.scratch/

# Default output of the ontoforge-sync export scripts. Anchored to the repo
# root on purpose: an unanchored pattern would also swallow plugins/ontoforge/.
/ontoforge/
