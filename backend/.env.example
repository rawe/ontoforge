DB_URI=bolt://localhost:7687
DB_USER=neo4j
DB_PASSWORD=ontoforge_dev

# Semantic search (optional — omit EMBEDDING_PROVIDER to disable)
# Provider: "ollama" or "openai" (OpenAI-compatible API)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_API_KEY=             # required for openai provider
# EMBEDDING_DIMENSIONS=          # optional — defaults: ollama=768, openai=1536

# AI-powered runtime (optional — omit AI_PROVIDER to disable)
# Requires a model with tool calling support.
# Recommended: qwen3:8b (~6 GB), qwen3:14b (~11 GB), qwen3:32b (~22 GB)
# Provider: "ollama" or "openai" (OpenAI-compatible API)
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:8b
# AI_BASE_URL=http://localhost:11434
# AI_API_KEY=                      # required for openai provider

# MCP default ontology key (optional — used when no key in URL path or header)
# DEFAULT_MCP_ONTOLOGY_KEY=my_ontology
