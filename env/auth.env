# Authentication on, against the development Keycloak (./dev.sh keycloak).
#
#   ./dev.sh keycloak                  # writes env/auth.local.env = this file + secrets
#   ./dev.sh env/auth.local.env
#
# This preset has no client secret and no administrator subject: booted as it is, the
# server refuses to start and names the missing variable. Never put a secret here — this
# directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
# The server's address: MCP clients connect and sign in here.
PUBLIC_URL=http://localhost:8000
# The web client's address (Vite): browser sign-in runs here, the login callback is
# WEB_CLIENT_URL/api/auth/callback.
WEB_CLIENT_URL=http://localhost:5173

# --- Authentication --------------------------------------------------------
AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8180/realms/ontoforge
OIDC_CLIENT_ID=ontoforge-web
OIDC_AUDIENCE=ontoforge-api
# Users, identities and role assignments: a database of its own in the same PostgreSQL,
# created by the server when missing.
ACCESS_DB_URI=postgresql://localhost:5432/ontoforge_access
