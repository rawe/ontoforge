# Authentication on, against the development Keycloak (./dev.sh keycloak).
#
#   ./dev.sh keycloak                  # writes env/auth.local.env = this file + secrets
#   ./dev.sh env/auth.local.env
#
# This preset has no client secret and no administrator subject: booted as it is, the
# server refuses to start and names the missing variable. Never put a secret here — this
# directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
# The server's address: MCP clients and own tools sign in here (the authorization server);
# the identity provider redirects to PUBLIC_URL/oauth/callback.
PUBLIC_URL=http://localhost:8000
# The web client's address (Vite): browser sign-in runs here, the login callback is
# WEB_CLIENT_URL/api/auth/callback.
WEB_CLIENT_URL=http://localhost:5173

# --- Authentication --------------------------------------------------------
AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8180/realms/ontoforge
OIDC_CLIENT_ID=ontoforge-web
# The audience a machine's provider token (client credentials) carries; unset: only people
# sign in, at the web client or through OntoForge's authorization server.
OIDC_AUDIENCE=ontoforge-api
# The token claim naming a person or machine at the provider (default sub).
#OIDC_SUBJECT_CLAIM=sub
# Clients of OntoForge's authorization server that publish no client metadata document:
# `client ID|display name|redirect URIs`, several separated by `;`. ontoforge-cli is
# scripts/auth/cli.mjs; a loopback redirect URI matches any port.
OAUTH_CLIENTS=ontoforge-cli|OntoForge CLI|http://127.0.0.1/callback
# The hosts client metadata documents are fetched from (default: any public https host).
#OAUTH_CLIENT_HOSTS=claude.ai,chatgpt.com
# Users, identities and role assignments: a database of its own in the same PostgreSQL,
# created by the server when missing.
ACCESS_DB_URI=postgresql://localhost:5432/ontoforge_access
