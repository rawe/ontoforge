# Example configuration: local Ollama plus TypeSafe's Jev Decision API.
# Copy this template to an uncommitted file, replace the API-key placeholder,
# then start OntoForge with that file:
#
#   cp env/ollama-decision.env env/ollama-decision.local.env
#   ./dev.sh env/ollama-decision.local.env
#
# This file is the whole configuration for that run: server/.env is not read
# when it is named. A variable already set in your shell still wins over it.
#
# NEVER put an API key in a file under `env/` — this directory is committed.
# Credentials belong in an uncommitted `env/*.local.env`.

# --- Datastore -------------------------------------------------------------
# Matches the dev stack in docker-compose.yml.
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Embedding (semantic search) -------------------------------------------
# To drive this same Ollama host through the OpenAI-compatible client
# instead of Ollama's native embeddings endpoint, override for one run:
#   EMBEDDING_PROVIDER=openai EMBEDDING_API_KEY=ollama ./dev.sh env/ollama-decision.env
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=1024

# --- Language model (AI capabilities) --------------------------------------
# The model must support tool calling.
AI_PROVIDER=ollama
AI_MODEL=gemma4:12b-mlx
AI_BASE_URL=http://localhost:11434
# How hard the model thinks: none, low, medium or high.
# Unset sends nothing and leaves the model at its own default — not the same
# as "none". Not every model honours the graded levels.
#AI_REASONING_EFFORT=

# --- Decision model (typed decisions) --------------------------------------
# Requires a TypeSafe account and your own API key. Replace the placeholder
# below in your uncommitted copy; never commit a real credential.
# The client appends /v1/systemone to this base URL.
# Jev 1.13 is pinned to its versioned model ID for reproducible configuration.
# API: https://docs.typesafe.ai/api
# Models: https://docs.typesafe.ai/models
DECISION_BASE_URL=https://api.typesafe.ai
DECISION_MODEL=jev-1.13.0
# PLACEHOLDER: replace with your own TypeSafe API key before making calls.
DECISION_API_KEY=REPLACE_WITH_YOUR_TYPESAFE_API_KEY
# For another TypeSafe/System One-compatible provider, replace the base URL,
# model identifier and credential with that provider's values. The endpoint
# must implement POST /v1/systemone with compatible request/response bodies.
