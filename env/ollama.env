# Local development, everything on Ollama.
#
#   ./dev.sh env/ollama.env
#
# This file is the whole configuration for that run: server/.env is not read
# when it is named. A variable already set in your shell still wins over it.

# --- Datastore -------------------------------------------------------------
# Matches the dev stack in docker-compose.yml.
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Embedding (semantic search) -------------------------------------------
# To drive this same Ollama host through the OpenAI-compatible client
# instead of Ollama's native embeddings endpoint, override for one run:
#   EMBEDDING_PROVIDER=openai EMBEDDING_API_KEY=ollama ./dev.sh env/ollama.env
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=768

# --- Language model (AI capabilities) --------------------------------------
# The model must support tool calling.
AI_PROVIDER=ollama
AI_MODEL=gemma4:12b-mlx
AI_BASE_URL=http://localhost:11434
# How hard the model thinks: none, low, medium or high.
# Unset sends nothing and leaves the model at its own default — not the same
# as "none". Not every model honours the graded levels.
#AI_REASONING_EFFORT=
