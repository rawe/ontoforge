# Shared-state harness with authentication on: env/scale.env plus the auth settings.
#
#   ./dev.sh keycloak                          # writes env/scale-auth.local.env
#   COMPOSE_PROFILES=ui ./dev.sh scale up env/scale-auth.local.env
#
# Host names are the Compose services. Keep plain KEY=VALUE lines.
# NEVER put a secret in a file under `env/` — this directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://postgres:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
SHUTDOWN_DRAIN_SECONDS=20
# The harness's frontend container (profile ui), the browser's origin.
PUBLIC_URL=http://localhost:13000

# --- Shared state ----------------------------------------------------------
SHARED_STATE=valkey
VALKEY_URL=redis://valkey:6379

# --- Embedding and language model: the deterministic fake --------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=fake-embed
EMBEDDING_BASE_URL=http://fake-ollama:11434
EMBEDDING_DIMENSIONS=16
AI_PROVIDER=ollama
AI_MODEL=fake-chat
AI_BASE_URL=http://fake-ollama:11434

# --- Authentication --------------------------------------------------------
AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8180/realms/ontoforge
# The backends join Keycloak's network (docker/scale/compose.auth.yml) and reach it here;
# tokens still name OIDC_ISSUER.
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/ontoforge
OIDC_CLIENT_ID=ontoforge-web
OIDC_AUDIENCE=ontoforge-api
ACCESS_DB_URI=postgresql://postgres:5432/ontoforge_access
