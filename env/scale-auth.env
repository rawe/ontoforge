# Shared-state harness with authentication on: env/scale.env plus the auth settings.
#
#   ./dev.sh keycloak                          # writes env/scale-auth.local.env
#   ./dev.sh scale up env/scale-auth.local.env   # adds the frontend (ui profile) itself
#
# Host names are the Compose services. Keep plain KEY=VALUE lines.
# NEVER put a secret in a file under `env/` — this directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://postgres:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
SHUTDOWN_DRAIN_SECONDS=20
# The server's address: the load balancer. MCP clients and own tools sign in here (the
# authorization server); the identity provider redirects to PUBLIC_URL/oauth/callback.
PUBLIC_URL=http://localhost:18000
# The harness's frontend container (profile ui): browser sign-in runs here.
WEB_CLIENT_URL=http://localhost:13000

# --- Shared state ----------------------------------------------------------
SHARED_STATE=valkey
VALKEY_URL=redis://valkey:6379

# --- Embedding and language model: the deterministic fake --------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=fake-embed
EMBEDDING_BASE_URL=http://fake-ollama:11434
EMBEDDING_DIMENSIONS=16
AI_PROVIDER=ollama
AI_MODEL=fake-chat
AI_BASE_URL=http://fake-ollama:11434

# --- Authentication --------------------------------------------------------
AUTH_ENABLED=true
OIDC_ISSUER=http://localhost:8180/realms/ontoforge
# The backends join Keycloak's network (docker/scale/compose.auth.yml) and reach it here;
# tokens still name OIDC_ISSUER.
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/ontoforge
OIDC_CLIENT_ID=ontoforge-web
# The audience a machine's provider token (client credentials) carries; unset: only people
# sign in, at the web client or through OntoForge's authorization server.
OIDC_AUDIENCE=ontoforge-api
# The token claim naming a person or machine at the provider (default sub).
#OIDC_SUBJECT_CLAIM=sub
# Clients of OntoForge's authorization server that publish no client metadata document:
# `client ID|display name|redirect URIs`, several separated by `;`. ontoforge-cli is
# scripts/auth/cli.mjs; a loopback redirect URI matches any port.
OAUTH_CLIENTS=ontoforge-cli|OntoForge CLI|http://127.0.0.1/callback
# The hosts client metadata documents are fetched from (default: any public https host).
#OAUTH_CLIENT_HOSTS=claude.ai
ACCESS_DB_URI=postgresql://postgres:5432/ontoforge_access
