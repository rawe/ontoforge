# A host process joining the shared-state harness, for debugging with source
# maps and breakpoints next to the two containers.
#
#   ./dev.sh scale up
#   ./dev.sh env/scale-host.env        # this process on :8000, Vite on top
#
# It runs the current source while the containers run the last image build:
# a new storage step here upgrades the shared database, and the older images
# then refuse to boot — rebuild them with ./dev.sh scale up.
#
# NEVER put an API key in a file under `env/` — this directory is committed.

# --- Datastore -------------------------------------------------------------
# The harness database (docker/scale/compose.yml), not the dev database.
DB_BACKEND=postgres
DB_URI=postgresql://localhost:25432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Shared state ----------------------------------------------------------
SHARED_STATE=valkey
VALKEY_URL=redis://localhost:26379

# --- Embedding (semantic search) -------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=fake-embed
EMBEDDING_BASE_URL=http://localhost:18080
EMBEDDING_DIMENSIONS=16

# --- Language model (AI capabilities) --------------------------------------
AI_PROVIDER=ollama
AI_MODEL=fake-chat
AI_BASE_URL=http://localhost:18080
