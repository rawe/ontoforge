# Shared-state harness on the real Ollama of the host, for a manual smoke test
# of a conversation across both backends. The scenario and benchmark scripts
# need the deterministic fake (env/scale.env).
#
#   ./dev.sh scale reset               # the fake's 16-wide vectors do not mix with bge-m3
#   ./dev.sh scale up env/scale-ollama.env
#
# NEVER put an API key in a file under `env/` — this directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://postgres:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Shared state ----------------------------------------------------------
SHARED_STATE=valkey
VALKEY_URL=redis://valkey:6379

# --- Embedding (semantic search) -------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_DIMENSIONS=1024

# --- Language model (AI capabilities) --------------------------------------
# The model must support tool calling.
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b-mlx
AI_BASE_URL=http://host.docker.internal:11434
