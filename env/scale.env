# Shared-state harness: the configuration of both backends in
# docker/scale/compose.yml (read through Compose `env_file`).
#
#   ./dev.sh scale up
#
# Host names are the Compose services. Keep plain KEY=VALUE lines: Compose and
# the server parse quoting differently.
#
# NEVER put an API key in a file under `env/` — this directory is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://postgres:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
# Running requests and chat streams get this long to finish on a stop; the
# backends' stop_grace_period (40 s) covers it.
SHUTDOWN_DRAIN_SECONDS=20

# --- Conversations ---------------------------------------------------------
# Shared by every backend, so a conversation continues on any of them.
THREAD_STORE=valkey
VALKEY_URL=redis://valkey:6379

# --- Embedding (semantic search) -------------------------------------------
# The deterministic fake model server (scripts/scale/fake-ollama.mjs).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=fake-embed
EMBEDDING_BASE_URL=http://fake-ollama:11434
EMBEDDING_DIMENSIONS=16

# --- Language model (AI capabilities) --------------------------------------
# The fake answers every chat with "user-messages:<count>", which shows that a
# turn saw the conversation's earlier turns, whichever backend ran them.
AI_PROVIDER=ollama
AI_MODEL=fake-chat
AI_BASE_URL=http://fake-ollama:11434
