# Integration tests — the AI suite (`npm run test:integration:ai`).
#
# The test database of `env/test.env` plus a local Ollama language model, so a
# default run is free and needs no credential. The suite skips when Ollama or
# the model is unavailable.
#
# To run against a paid provider, copy this file to `env/test-ai.local.env`
# (gitignored), put the provider and key there, and name it for that run:
#
#   ENV_FILE=../env/test-ai.local.env npm run test:integration:ai
#
# NEVER put an API key in THIS file — `env/` is committed.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge_test
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Language model --------------------------------------------------------
# The model must support tool calling.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
AI_BASE_URL=http://localhost:11434
# How hard the model thinks: none, low, medium or high. Unset leaves the model
# at its own default, which is not the same as "none".
#AI_REASONING_EFFORT=
