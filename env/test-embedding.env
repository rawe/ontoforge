# Integration tests — the semantic-search suite
# (`npm run test:integration:embedding`).
#
# The test database of `env/test.env` plus a local Ollama embedding provider.
# The suite skips when Ollama is unavailable.
#
# NEVER put an API key in a file under `env/` — this directory is committed.
# Credentials belong in an uncommitted `env/*.local.env`.

# --- Datastore -------------------------------------------------------------
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge_test
DB_USER=postgres
DB_PASSWORD=ontoforge_dev

# --- Embedding -------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=768
