                      }
                    ],
                    "textFields": [
                      "name"
                    ],
                    "targetField": "hall_number"
                  },
                  {
                    "id": "industry",
                    "mode": "soft",
                    "path": [
                      {
                        "direction": "outgoing",
                        "relationTypeKey": "belongs_to_industry"
                      }
                    ],
                    "textFields": [
                      "name",
                      "description"
                    ],
                    "targetField": "name"
                  }
                ],
                "answerFields": [
                  "name",
                  "stand_number",
                  "founded",
                  "description"
                ],
                "searchFields": [
                  "name",
                  "description"
                ],
                "entityTypeKey": "exhibitor"
              },
              {
                "conditions": [
                  {
                    "id": "hall",
                    "mode": "hard",
                    "path": [
                      {
                        "direction": "outgoing",
                        "relationTypeKey": "takes_place_in"
                      }
                    ],
                    "textFields": [
                      "name"
                    ],
                    "targetField": "hall_number"
                  }
                ],
                "answerFields": [
                  "title",
                  "event_type",
                  "starts_at"
                ],
                "searchFields": [
                  "title",
                  "description"
                ],
                "entityTypeKey": "event"
              }
            ],
            "threshold": 0.35,
            "answerFieldCharacters": 600
          }
        }
      ]
    },
    {
      "key": "visitor_guide",
