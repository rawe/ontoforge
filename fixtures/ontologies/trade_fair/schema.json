      "aiAgents": [
        {
          "key": "visitor_assistant",
          "name": "Visitor Guide Assistant",
          "description": "Helps fair visitors find exhibitors, stands and halls for their interests.",
          "systemPrompt": "You are the visitor assistant of the Meridian Industrial Technology Fair 2027. Help visitors find exhibitors that match their interests and tell them where to find them. Use search to find exhibitors by topic, and search_documents with get_document to quote the relevant passage of an exhibitor description. Use list_entities and get_neighbors to resolve halls, industries and product groups of an exhibitor. Always give the exhibitor name, stand number and hall. Answer only from the data the tools return; if nothing matches, say so.",
          "tools": [
            "get_schema",
            "search",
            "search_documents",
            "get_document",
            "list_entities",
            "get_entity",
            "get_neighbors",
            "execute_query",
            "list_saved_queries",
            "run_saved_query"
          ]
        }
      ],
      "savedQueries": [
        {
          "key": "exhibitors-in-hall",
          "name": "Exhibitors In Hall",
          "description": "List the exhibitors of one hall with their stand numbers, ordered by stand.",
          "steps": [
            {
              "name": "main",
              "type": "oql",
              "oql": "MATCH (e:exhibitor)-[:located_in]->(h:hall) WHERE h.hall_number = $hall RETURN e.name, e.stand_number ORDER BY e.stand_number",
              "entityTypeKey": null,
              "query": null,
              "limit": null,
              "bindings": null
            }
          ],
          "parameters": [
            {
              "name": "hall",
              "description": "Hall number, for example \"2\"",
              "dataType": "string"
            }
          ]
        },
        {
          "key": "find-exhibitor-stands",
          "name": "Find Exhibitor Stands",
          "description": "Search exhibitors by topic, then return their stand numbers and halls.",
          "steps": [
            {
              "name": "hits",
              "type": "search",
              "oql": null,
              "entityTypeKey": "exhibitor",
              "query": "$q",
              "limit": 5,
              "bindings": null
            },
            {
              "name": "stands",
              "type": "oql",
              "oql": "MATCH (e:exhibitor)-[:located_in]->(h:hall) WHERE e._id IN $ids RETURN e.name, e.stand_number, h.name",
              "entityTypeKey": null,
              "query": null,
              "limit": null,
              "bindings": {
                "ids": "{{hits._id}}"
              }
            }
          ],
          "parameters": [
            {
              "name": "q",
              "description": "What the visitor is looking for",
              "dataType": "string"
            }
          ]
        }
      ],
