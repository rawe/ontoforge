# nginx template — processed by envsubst on container start.
# BACKEND_URL must be set to the internal URL of the OntoForge server
# (e.g. http://server:8000). In development the Vite dev server handles
# proxying; in Docker this nginx config takes over that role.

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API and MCP requests to the backend server.
    # The frontend app uses relative paths (/api/..., /mcp/...) for all
    # backend calls. Without these proxy rules the requests would hit
    # nginx's try_files fallback and return index.html instead of JSON.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mcp/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
