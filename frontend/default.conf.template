# nginx template — processed by envsubst on container start.
# BACKEND_URL must be set to the internal URL of the OntoForge server
# (e.g. http://server:8000). In development the Vite dev server handles
# proxying; in Docker this nginx config takes over that role.

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API requests to the backend server. The frontend app
    # uses relative paths (/api/...) for all backend calls, so the browser's
    # session cookie reaches the server. Without this rule the requests would
    # hit nginx's try_files fallback and return index.html instead of JSON.
    # MCP clients connect to the server directly, never through here.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
