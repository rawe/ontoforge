{
  "name": "@rawe/ontoforge-runtime",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the OntoForge Runtime API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ontoforge",
    "ontology",
    "neo4j",
    "knowledge-graph",
    "sdk",
    "client"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rawe/ontoforge",
    "directory": "packages/runtime-client"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  }
}
