{
  "mcpServers": {
    "ontoforge-modeling": {
      "type": "http",
      "url": "${ONTOFORGE_BASE_URL}/mcp/ontologies/my_ontology/model",
      "headers": {
        "Authorization": "Bearer ${ONTOFORGE_API_TOKEN}"
      }
    },
    "ontoforge-runtime": {
      "type": "http",
      "url": "${ONTOFORGE_BASE_URL}/mcp/ontologies/my_ontology/runtime/lenses/my_lens",
      "headers": {
        "Authorization": "Bearer ${ONTOFORGE_API_TOKEN}"
      }
    }
  }
}
