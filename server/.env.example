# OntoForge TypeScript server — environment variables.
# Copy to `.env` (gitignored) and adjust. Every value shown is the built-in
# default from src/config.ts.
#
# Exactly one env file is read: the one `ENV_FILE` names, otherwise `.env` in
# the working directory. A real environment variable wins over the file, and a
# named file that is missing fails the boot. `../env/` holds committed presets
# for `./dev.sh`.

# --- Datastore -------------------------------------------------------------
# Which storage adapter to use, and how to reach the database.
# The DSN carries host/port/database; credentials ride separately.
DB_BACKEND=postgres
DB_URI=postgresql://localhost:5432/ontoforge
DB_USER=postgres
DB_PASSWORD=ontoforge_dev
# Neo4j adapter (matches the commented service in docker-compose.yml).
#DB_BACKEND=neo4j
#DB_URI=bolt://localhost:7687
#DB_USER=neo4j
#DB_PASSWORD=ontoforge_dev

# --- Server ----------------------------------------------------------------
PORT=8000

# --- Embedding (semantic search) -------------------------------------------
# Unset EMBEDDING_PROVIDER means semantic search is unavailable.
#EMBEDDING_PROVIDER=ollama
#EMBEDDING_MODEL=nomic-embed-text
#EMBEDDING_BASE_URL=http://localhost:11434
#EMBEDDING_API_KEY=
#EMBEDDING_DIMENSIONS=

# --- Documents -------------------------------------------------------------
#DOCUMENT_CHUNK_SIZE=1500
#DOCUMENT_CHUNK_OVERLAP=200

# --- Language model (AI capabilities) --------------------------------------
# Unset AI_PROVIDER means AI capabilities are unavailable.
#AI_PROVIDER=ollama
#AI_MODEL=qwen3:8b
#AI_BASE_URL=http://localhost:11434
#AI_API_KEY=
# How hard the model thinks: none, low, medium or high.
# Unset sends nothing and leaves the model at its own default — which is not
# the same as "none". Not every model honours the graded levels.
#AI_REASONING_EFFORT=

# AI_PROVIDER=openai names the OpenAI wire protocol, not the vendor: any host
# speaking it works. AI_BASE_URL must stop before /v1 — the client appends it.
# The model must support tool calling. OpenRouter:
#AI_PROVIDER=openai
#AI_BASE_URL=https://openrouter.ai/api
#AI_MODEL=openai/gpt-5.6-luna
#AI_API_KEY=sk-or-v1-...
#AI_REASONING_EFFORT=high

# --- Local AI testing ------------------------------------------------------
# LOCAL TESTING ONLY. Never read by the server — only by the AI integration
# suite (tests/integration/ai/). Nothing in src/ looks at it.
#
#   AI_TEST=0  (or unset)  the AI suite skips every test. Default.
#   AI_TEST=1              the AI suite runs against the AI_* settings above.
#
# The suite drives a real language model, so a paid AI_BASE_URL bills for
# every run. Leave this at 0 and arm it per run on the command line, which
# wins over this file:
#
#   AI_TEST=1 npm run test:integration:ai
#
#AI_TEST=0

# --- Misc ------------------------------------------------------------------
# Base address advertised in agent cards; unset advertises a local address.
#PUBLIC_URL=
# Fallback ontology key for runtime-MCP connections without one.
#DEFAULT_MCP_ONTOLOGY_KEY=
