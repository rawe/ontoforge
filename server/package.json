{
  "name": "ontoforge-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OntoForge server (TypeScript)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
